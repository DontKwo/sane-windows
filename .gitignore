# Snapshots contain local system state dumps
snapshots/*.json
!snapshots/.gitkeep

# Build outputs
build/

# Exported configs
config.exported.yaml

# Temporary debugging scripts
test_*.ps1
patch.*
*.tmp

# Orchestrator state
.orchestrator_state.json

# Logs
*.log

# Linter cache & reports
.lint_cache.json
lint_report*.txt

# Sensitive patterns
.env
secrets.json
